let TERM=null, tsel='N-001', tedit={};
async function renderGanti(){
  const w=document.getElementById('gantiWrap'); if(!w) return;
  if(!['MBPG','MBIP'].includes(sel.pbt)){
    w.innerHTML=`<div class="empty">${tr('Ganti Nilai untuk','Replace Values for')} ${sel.pbt} ${tr('belum disambung — enjin skrip '+sel.pbt+' akan diunifikasi. MBPG & MBIP tersedia.','not connected yet — the '+sel.pbt+' script engine will be unified. MBPG & MBIP are available.')}</div>`;
    return;
  }
  if(window._gantiPbt!==sel.pbt){ tedit={}; window._gantiPbt=sel.pbt; }
  try{ const r=await fetch('/api/terminal/data?pbt='+sel.pbt,{cache:'no-store'}); TERM=await r.json(); }
  catch(e){ w.innerHTML='<div class="empty">'+tr('Server terminal tidak tersedia','Terminal server unavailable')+'</div>'; return; }
  drawGanti();
}
function tval(b,k){ return (tedit[b]&&k in tedit[b])?tedit[b][k]:TERM.borang[b][k]; }
function tset(b,k,v){ (tedit[b]=tedit[b]||{})[k]=v; drawGanti(); }
function drawGanti(){
  const w=document.getElementById('gantiWrap'); if(!w||!TERM) return;
  const b=tsel, fields=TERM.borang[b];
  const node=(TERM.pokok||[]).find(p=>p.kompaun===tval(b,'keterangan_kod_kompaun'));
  const aktas=node?node.akta.map(a=>a.akta):[];
  const anode=node?node.akta.find(a=>a.akta===tval(b,'kod_akta')||a.akta.includes(tval(b,'kod_akta'))):null;
  const kess=anode?anode.kesalahan.map(k=>k.kesalahan):[];
  let nUbah=0;
  const row=(k)=>{
    const v=tval(b,k); const ubah=String(v)!==String(TERM.borang[b][k]);
    if(ubah) nUbah++;
    const style=`width:100%;background:var(--panel2);border:1px solid ${ubah?'var(--lain)':'var(--line2)'};border-radius:7px;color:var(--ink);padding:6px 9px;font-size:.7rem;outline:none`;
    const opts= k==='keterangan_kod_kompaun'?(TERM.pokok||[]).map(p=>p.kompaun)
              : k==='kod_akta'?aktas : k==='kesalahan_kompaun'?kess : null;
    if(opts){
      const o=opts.includes(v)?opts:[v,...opts];
      return `<div style="display:grid;grid-template-columns:210px 1fr;gap:8px;align-items:center;padding:3px 0">
        <span style="font-family:Consolas,monospace;font-size:.64rem;color:var(--dim)">${k} 🔗</span>
        <select style="${style}" onchange="tset('${b}','${k}',this.value)">
          ${o.map(x=>`<option ${x===v?'selected':''}>${esc(x)}</option>`).join('')}</select></div>`;
    }
    return `<div style="display:grid;grid-template-columns:210px 1fr;gap:8px;align-items:center;padding:3px 0">
      <span style="font-family:Consolas,monospace;font-size:.64rem;color:var(--dim)">${k}</span>
      <input style="${style}" value="${esc(v)}" onchange="tset('${b}','${k}',this.value)"></div>`;
  };
  const rows=Object.keys(fields).map(row).join('');
  const a=TERM.ai;
  w.innerHTML=`
  <div style="display:flex;gap:6px;margin-bottom:10px">
    ${['N-001','P-001','K-001'].map(x=>`<span class="fchip ${tsel===x?'on':''}" onclick="tsel='${x}';drawGanti()">${x}</span>`).join('')}
    <span class="fchip ${tsel==='AI'?'on':''}" onclick="tsel='AI';drawGanti()">AI API</span>
  </div>
  ${tsel==='AI'?gantiAiHtml(a):`
  <div class="note">${tr('Ubah nilai → JANA SKRIP: override ditulis ke testdata '+sel.pbt+' (asal auto-backup). Kombo kompaun→akta→kesalahan divalidasi lawan pokok production — kombo tak wujud DITOLAK.','Edit values → GENERATE: overrides are written into '+sel.pbt+' testdata (originals auto-backed up). The kompaun→akta→kesalahan combo is validated against the production tree — unknown combos are REJECTED.')}</div>
  <div class="step" style="border-left-color:var(--cyan)">${rows}</div>
  <div style="display:flex;gap:10px;align-items:center;margin-top:10px">
    <span id="tstatus" style="font-size:.66rem;color:var(--dim);flex:1">${nUbah?nUbah+tr(' medan diubah — belum dijana',' field(s) changed — not generated yet'):tr('Tiada perubahan','No changes')}</span>
    <button class="fchip" onclick="tedit={};drawGanti()">RESET</button>
    <button class="fchip on" style="color:var(--pass);border-color:var(--pass)" ${nUbah?'':'disabled'} onclick="tJana()">${tr('JANA SKRIP','GENERATE')}</button>
  </div>`}`;
}
function gantiAiHtml(a){
  return `<div class="note">OpenAI-compatible — paste base URL &amp; API key pembekal. Disimpan LOKAL sahaja (ai_config.json — jangan commit).</div>
  <div class="step" style="border-left-color:#a78bfa">
    <div style="display:grid;grid-template-columns:210px 1fr;gap:8px;padding:3px 0"><span style="font-size:.64rem;color:var(--dim)">base_url</span><input id="tUrl" class="search" style="width:100%;margin:0" value="${esc(a.base_url)}" placeholder="https://api.pembekal.com/v1"></div>
    <div style="display:grid;grid-template-columns:210px 1fr;gap:8px;padding:3px 0"><span style="font-size:.64rem;color:var(--dim)">api_key</span><input id="tKey" type="password" class="search" style="width:100%;margin:0" placeholder="${a.key_set?'•••••• (tersimpan)':'sk-...'}"></div>
    <div style="display:grid;grid-template-columns:210px 1fr;gap:8px;padding:3px 0"><span style="font-size:.64rem;color:var(--dim)">model</span><select id="tModel" class="search" style="width:100%;margin:0">${TERM.models.map(m=>`<option ${m===a.model?'selected':''}>${m}</option>`).join('')}</select></div>
  </div>
  <div style="display:flex;gap:10px;align-items:center;margin-top:10px">
    <span id="tstatus" style="font-size:.66rem;color:var(--dim);flex:1"></span>
    <button class="fchip" onclick="tAiTest()">UJI SAMBUNGAN</button>
    <button class="fchip on" onclick="tAiSave()">SIMPAN</button>
  </div>`;
}
async function tJana(){
  const s=document.getElementById('tstatus'); s.textContent=tr('menjana...','generating...');
  const r=await fetch('/api/terminal/jana',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({pbt:sel.pbt,perubahan:tedit})});
  const d=await r.json();
  if(d.ok){ tedit={}; await renderGanti();
    const s2=document.getElementById('tstatus');
    if(s2){ s2.textContent=tr('✔ Skrip dijana — backup: ','✔ Generated — backup: ')+d.backup; s2.style.color='var(--pass)'; }
  } else { s.textContent=tr('DITOLAK: ','REJECTED: ')+JSON.stringify(d.ralat); s.style.color='var(--fail)'; }
}
async function tAiSave(){
  const body={base_url:document.getElementById('tUrl').value, model:document.getElementById('tModel').value};
  const k=document.getElementById('tKey').value; if(k) body.api_key=k;
  await fetch('/api/terminal/ai_config',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
  const s=document.getElementById('tstatus'); s.textContent='✔ Disimpan (lokal)'; s.style.color='var(--pass)';
}
async function tAiTest(){
  await tAiSave();
  const s=document.getElementById('tstatus'); s.textContent='menguji...'; s.style.color='var(--dim)';
  const r=await fetch('/api/terminal/ai_test',{method:'POST'}); const d=await r.json();
  s.textContent=d.mesej; s.style.color=d.ok?'var(--pass)':'var(--fail)';
}

